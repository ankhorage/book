{
  "name": "@ankhorage/book",
  "version": "0.1.0",
  "description": "Standalone book authoring, import, preview, and export toolkit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "ankh": {
    "category": "book",
    "provider": "./dist/cli/provider.js",
    "capabilities": [
      {
        "id": "book.init",
        "owner": "@ankhorage/book",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Create an editable book project.",
        "description": "Create an editable book project."
      },
      {
        "id": "book.import",
        "owner": "@ankhorage/book",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Import PDF, EPUB, or Markdown.",
        "description": "Import PDF, EPUB, or Markdown."
      },
      {
        "id": "book.preview",
        "owner": "@ankhorage/book",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Preview actual EPUB and PDF output locally.",
        "description": "Preview actual EPUB and PDF output locally."
      },
      {
        "id": "book.export",
        "owner": "@ankhorage/book",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Export EPUB and PDF.",
        "description": "Export EPUB and PDF."
      },
      {
        "id": "book.validate",
        "owner": "@ankhorage/book",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Validate an editable book project.",
        "description": "Validate an editable book project."
      }
    ]
  },
  "bin": {
    "ankh-book": "./dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/book.git"
  },
  "homepage": "https://github.com/ankhorage/book#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/book/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@ankhorage/devtools": "^2.3.31",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.3"
  },
  "scripts": {
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "test": "bun test src",
    "prepack": "bun run build",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main"
  },
  "dependencies": {
    "@ankhorage/ankh": "^0.13.2",
    "@ankhorage/contracts": "^26.2.0",
    "@react-pdf/renderer": "^4.3.2",
    "@zip.js/zip.js": "^2.23.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.3",
    "yaml": "^2.9.1"
  }
}
